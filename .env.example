# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Security & Dashboard Protection
# Set a secure secret key to protect dashboard controls and API mutation endpoints
ADMIN_SECRET=change-me-to-a-secure-random-passphrase
# Dedicated token for OBS Browser Source to connect and receive overlay updates
OVERLAY_TOKEN=streamer-obs-overlay-key-2026

# Kick Channel Configuration
# Channel slug (username) where the giveaway runs (e.g., xqc, yourchannel)
KICK_CHANNEL_SLUG=demo_channel
# Broadcaster User ID (Required for sending messages via Kick Public API)
KICK_BROADCASTER_ID=

# Kick Developer API Authentication (https://dev.kick.com)
# Obtain from Kick Developer Portal -> Applications
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# OAuth Bearer Access Token with scopes: chat:write, channel:read, events:subscribe
KICK_ACCESS_TOKEN=
# Webhook Secret for signature validation (Kick-Event-Signature)
KICK_WEBHOOK_SECRET=

# Bot Behavior Defaults
DEFAULT_ENTRY_KEYWORD=!join
BOT_REPLY_ENABLED=true
BOT_ANNOUNCE_WINNER=true
# Rate limiting on bot replies in milliseconds (prevents chat flooding)
BOT_CHAT_COOLDOWN_MS=1500

# Storage
DATABASE_PATH=./data/giveaway.db
